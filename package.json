{
  "name": "@canoziia/pi-goal",
  "version": "0.54.8",
  "description": "Pi extension for autonomous single-objective /goal completion.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "goal",
    "automation"
  ],
  "files": [
    "src",
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ]
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "check": "npm run build && npm run typecheck && npm test",
    "format": "biome check --write .",
    "test:runtime": "node ./test/goal-runtime-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "test": "node scripts/prepare-tests.mjs && vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "esbuild": "0.28.2",
    "typebox": "1.3.34",
    "typescript": "7.0.2",
    "vitest": "^4.0.0",
    "@types/node": "^24.0.0"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.59.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/canoziia/pi-goal.git"
  },
  "author": "narumiruna",
  "contributors": [
    "canoziia"
  ]
}
